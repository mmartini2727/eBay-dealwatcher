
# Added later when we wire up Browse API OAuth.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# V0.9: named by profiles/*.yaml's alerts.webhook_env. Required at container
# start if the profile has an alerts: block at all - the collector fails
# fast (ProfileCompileError) rather than starting with alerting silently
# broken. Not required for a profile with no alerts: block.
DISCORD_WEBHOOK_DEALS=

# V0.9a: required only if a profile's alerts.notifiers list includes
# "pushover" - unlike DISCORD_WEBHOOK_DEALS above, these two names are
# fixed, not profile-configurable, since a Pushover app/user pair is a
# per-deployment secret rather than a per-profile one. Both must be set and
# non-empty together, or the collector fails fast at startup the same way
# a missing webhook_env does.
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Runtime
LOG_LEVEL=INFO
